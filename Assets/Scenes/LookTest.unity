  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::VoicemailPhone
  id: Hollis_Payphone_Mother
  speaker: "M\xE3e"
  portuguese:
  - "Filho, sou eu, a m\xE3e. J\xE1 nem sei se este n\xFAmero ainda \xE9 teu..."
  - "O teu pai n\xE3o diz nada, mas pergunta por ti. \xC0 maneira dele."
  - "Liga-me quando puderes. S\xF3 para eu saber que est\xE1s bem. Beijinhos."
  english:
  - Son, it's me, Mom. I don't even know if this number is still yours...
  - Your father doesn't say anything, but he asks about you. In his own way.
  - Call me when you can. Just so I know you're okay. Love you.
  voice: {fileID: 0}
  secondsPerLine: 5.5
  bell: {fileID: 441646050}
  earpiece: {fileID: 1873456807}
  pickUp: {fileID: 8300000, guid: 4cd76b64282bdb443ad4df76f1b4d490, type: 3}
