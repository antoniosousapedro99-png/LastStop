--- !u!114 &2060332481
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2060332479}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e0ebec7cf3f99e2479d3c274ad354368, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::VoicemailPhone
  id: Hollis_Payphone_Mother
  speaker: "M\xE3e"
  portuguese:
  - "Filho, sou eu, a m\xE3e. J\xE1 nem sei se este n\xFAmero ainda \xE9 teu..."
  - "O teu pai n\xE3o diz nada, mas pergunta por ti. \xC0 maneira dele."
  - "Liga-me quando puderes. S\xF3 para eu saber que est\xE1s bem. Beijinhos."
  english:
  - Son, it's me, Mom. I don't even know if this number is still yours...
  - Your father doesn't say anything, but he asks about you. In his own way.
  - Call me when you can. Just so I know you're okay. Love you.
  voice: {fileID: 0}
  secondsPerLine: 5.5
  bell: {fileID: 2060332482}
  earpiece: {fileID: 638599327}
  pickUp: {fileID: 8300000, guid: 4cd76b64282bdb443ad4df76f1b4d490, type: 3}
  hangUp: {fileID: 8300000, guid: cc5dc0da223ae4d4a924038593172840, type: 3}
  lineHiss: {fileID: 8300000, guid: 26a9b110c6c027249981be1a5ba1d5ef, type: 3}
  ringDistance: 8
  ringFor: 20
  rearmDistance: 10
