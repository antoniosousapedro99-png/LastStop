  m_Script: {fileID: 11500000, guid: 52113e8dd3e45c24199dcdbcd5aeb742, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RadioMessages
  label: van radio
  lines:
  - 'DISPATCH: Unit 12, you there? The whole of Line 4 is dark. Start with Hollis Street.'
  - 'DISPATCH: Fuse box is down on the platform. Kowalski''s crew left spares in the tunnels... somewhere.'
  - 'DISPATCH: And check in every hour. The last crew stopped checking in.'
  secondsPerLine: 5
  playOnStart: 1
  crackle: {fileID: 8300000, guid: 178979b49afe57c488a66f4678ae2559, type: 3}
