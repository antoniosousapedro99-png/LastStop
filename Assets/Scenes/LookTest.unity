  m_Script: {fileID: 11500000, guid: e0ebec7cf3f99e2479d3c274ad354368, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::VoicemailPhone
  id: Hollis_Camp_Sister
  speaker: "Irm\xE3"
  portuguese:
  - "Sou eu. A m\xE3e pediu-me para te ligar, por isso n\xE3o te armes."
  - Fizeste anos e nem atendeste. Ela fez bolo na mesma.
  - "N\xE3o sei o que se passa contigo, Jota. Mas fugir n\xE3o resolve nada."
  english:
  - It's me. Mom asked me to call you, so don't get any ideas.
  - It was your birthday and you didn't even pick up. She baked a cake anyway.
  - I don't know what's going on with you, J. But running away doesn't fix anything.
  voice: {fileID: 0}
  secondsPerLine: 5.5
  bell: {fileID: 960855454}
  earpiece: {fileID: 1759443669}
  pickUp: {fileID: 8300000, guid: 4cd76b64282bdb443ad4df76f1b4d490, type: 3}
  hangUp: {fileID: 8300000, guid: cc5dc0da223ae4d4a924038593172840, type: 3}
